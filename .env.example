# Copy to .env and fill in. Never commit .env.

# Backend: comma-separated origins allowed to call the API (production frontend URL).
CORS_ORIGINS=

# Backend behind a hosting proxy (Render): set to * so the rate limit sees each visitor's IP
# instead of the proxy's. Leave empty locally.
FORWARDED_ALLOW_IPS=

# Frontend: deployed backend URL. Leave empty in local dev (the Vite proxy handles /api).
VITE_API_URL=
