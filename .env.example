# Copy to .env and fill in. Never commit .env.

# Backend: comma-separated origins allowed to call the API (production frontend URL).
CORS_ORIGINS=

# Backend behind a hosting proxy (Render): how many proxies append to X-Forwarded-For.
# 0 locally. See docs/deployment.md before changing it on Render.
TRUSTED_PROXY_HOPS=0

# Frontend: deployed backend URL. Leave empty in local dev (the Vite proxy handles /api).
VITE_API_URL=
